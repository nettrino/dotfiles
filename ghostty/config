# Port of alacritty.yml. Install: cp ghostty/config ~/.config/ghostty/config

font-family = Hack Nerd Font Mono
# alacritty ran on Linux at 11pt; macOS renders the same point size smaller
font-size = 13

background = #22272e
foreground = #d8d8d8
cursor-color = #ECEFF4
cursor-text = #3B4252
cursor-style-blink = false

palette = 0=#484f58
palette = 1=#ff8878
palette = 2=#4e9a06
palette = 3=#edd400
palette = 4=#73b7f2
palette = 5=#ffb2fe
palette = 6=#a2e1f8
palette = 7=#f1f1f1
palette = 8=#484f58
palette = 9=#fe978b
palette = 10=#84d831
palette = 11=#fce94f
palette = 12=#62b4f8
palette = 13=#ffc6ff
palette = 14=#c0e9f8
palette = 15=#ffffff

window-padding-x = 2
window-padding-y = 2
# bytes, not lines. ~100k lines like alacritty's history
scrollback-limit = 100000000

copy-on-select = clipboard
selection-word-chars = ,│`|:"' ()[]{}<>

# Alt as Meta like alacritty on Linux; also lets tmux M-arrow bindings work
macos-option-as-alt = true

keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+0=reset_font_size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
